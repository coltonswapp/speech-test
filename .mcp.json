{
  "mcpServers": {
    "shizen-studio": {
      "command": "sh",
      "args": [
        "-c",
        "cd \"$(git rev-parse --show-toplevel)\" && exec webapp/studio-mcp/node_modules/.bin/tsx webapp/studio-mcp/src/index.ts"
      ],
      "env": {
        "STUDIO_BASE_URL": "${STUDIO_BASE_URL:-http://localhost:3000}",
        "STUDIO_AGENT_TOKEN": "${STUDIO_AGENT_TOKEN:-}"
      }
    }
  }
}
