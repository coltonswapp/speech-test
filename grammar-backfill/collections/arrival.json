    },
    {
      "sceneId": "in-the-car",
      "title": "In the car",
      "spokenLines": [
        {
          "i": 0,
          "text": "お母さんは元気？",
          "speaker": "Obaachan"
        },
        {
          "i": 1,
          "text": "はい、元気です。",
          "speaker": "Emi"
        },
        {
          "i": 2,
          "text": "お父さんも元気？",
          "speaker": "Obaachan"
        },
        {
          "i": 3,
          "text": "はい、父も元気です。",
          "speaker": "Emi"
        },
        {
          "i": 4,
          "text": "そう、よかった。今日は暑いね。",
          "speaker": "Obaachan"
        },
        {
          "i": 5,
          "text": "はい、暑いです。カリフォルニアより暑いです。",
          "speaker": "Emi"
        },
        {
          "i": 6,
          "text": "あら、そうなの？",
          "speaker": "Obaachan"
        },
        {
          "i": 7,
          "text": "はい、驚きました。",
          "speaker": "Emi"
        },
        {
          "i": 8,
          "text": "家まで、三十分くらいよ。荷物を車に入れて、行きましょう。",
          "speaker": "Obaachan"
        },
        {
          "i": 9,
          "text": "はい、わかりました。",
          "speaker": "Emi"
        }
      ],
