  "scenes": [
    {
      "sceneId": "key-money",
      "title": "Key money",
      "spokenLines": [
        {
          "i": 0,
          "text": "いらっしゃいませ。",
          "speaker": "Rika"
        },
        {
          "i": 1,
          "text": "あの、家を探しています。",
          "speaker": "Yuto"
        },
        {
          "i": 2,
          "text": "お部屋、ですね。こちら、どうですか？渋谷駅から徒歩八分です。",
          "speaker": "Rika"
        },
        {
          "i": 3,
          "text": "家のお金、いくらですか？",
          "speaker": "Yuto"
        },
        {
          "i": 4,
          "text": "家賃は、十万円ですね。",
          "speaker": "Rika"
        },
        {
          "i": 5,
          "text": "十万円、ですか？",
          "speaker": "Yuto"
        },
        {
          "i": 6,
          "text": "あと、礼金が十万円です。",
          "speaker": "Rika"
        },
        {
          "i": 7,
          "text": "礼金、ですか？",
          "speaker": "Yuto"
        },
        {
          "i": 8,
          "text": "大家さんへの、お礼なんです。",
          "speaker": "Rika"
        },
        {
          "i": 9,
          "text": "お礼… あの、果物とかで、大丈夫ですか？",
          "speaker": "Yuto"
        },
        {
          "i": 10,
          "text": "ちょっと、お金で払うんです。",
          "speaker": "Rika"
        },
        {
          "i": 11,
          "text": "あ、そうなんですか？わかりました。",
          "speaker": "Yuto"
        },
        {
          "i": 12,
          "text": "ほかに、ありますか？",
          "speaker": "Rika"
        },
        {
          "i": 13,
          "text": "見ていいですか？",
          "speaker": "Yuto"
        },
        {
          "i": 14,
          "text": "内見ですね。かしこまりました。",
          "speaker": "Rika"
        },
        {
          "i": 15,
          "text": "はい、お願いします。",
          "speaker": "Yuto"
        }
      ],
      "grammar": [
        {
          "label": "です"
        },
        {
          "label": "か"
        }
      ]
    },
    {
      "sceneId": "meal-ticket",
      "title": "Meal ticket",
      "spokenLines": [
        {
          "i": 0,
          "text": "いらっしゃいませ。味噌ラーメン、ですね。",
          "speaker": "Nao"
        },
        {
          "i": 1,
          "text": "え、醤油なんですけど。",
          "speaker": "Yuto"
        },
        {
          "i": 2,
          "text": "食券、味噌ですよ。",
          "speaker": "Nao"
        },
        {
          "i": 3,
          "text": "食券、ですか？",
          "speaker": "Yuto"
        },
        {
          "i": 4,
          "text": "この紙です。機械の。",
          "speaker": "Nao"
        },
        {
          "i": 5,
          "text": "変えられますか？",
          "speaker": "Yuto"
        },
        {
          "i": 6,
          "text": "まだ、渡してないので。大丈夫です。",
          "speaker": "Nao"
        },
        {
          "i": 7,
          "text": "あ、よかったです。お願いします。",
          "speaker": "Yuto"
        },
        {
          "i": 8,
          "text": "はい。少々お待ちくださいね！",
          "speaker": "Nao"
        }
      ],
      "grammar": [
        {
          "label": "です"
        },
        {
          "label": "か"
        }
      ]
    },
    {
      "sceneId": "re-delivery",
      "title": "Re-delivery",
      "spokenLines": [
        {
          "i": 0,
          "text": "いらっしゃいませ。",
          "speaker": "Emi"
        },
        {
          "i": 1,
          "text": "荷物、受け取りたいです。",
          "speaker": "Yuto"
        },
        {
          "i": 2,
          "text": "不在票は、ありますか？",
          "speaker": "Emi"
        },
        {
          "i": 3,
          "text": "不在票、ですか？",
          "speaker": "Yuto"
        },
        {
          "i": 4,
          "text": "ピンクの紙です。ポストに入ってます。",
          "speaker": "Emi"
        },
        {
          "i": 5,
          "text": "写真、あるんですけど。",
          "speaker": "Yuto"
        },
        {
          "i": 6,
          "text": "紙本体が、必要なんです。",
          "speaker": "Emi"
        },
        {
          "i": 7,
          "text": "",
          "speaker": ""
        },
        {
          "i": 8,
          "text": "あ、部屋です。",
          "speaker": "Yuto"
        },
        {
          "i": 9,
          "text": "持ってきてください。今日も、再配達も、できます。",
          "speaker": "Emi"
        },
        {
          "i": 10,
          "text": "はい。取ってきます。",
          "speaker": "Yuto"
        }
      ],
      "grammar": [
        {
          "label": "です"
        },
        {
          "label": "か"
        }
      ]
