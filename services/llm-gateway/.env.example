# Copy to .env for local runs. Never commit .env.
GEMINI_API_KEY=
FIREBASE_PROJECT_ID=shizen-b453f
PORT=8080

# Server-only. Signs feedback tokens. At least 32 characters. Never ship this in the app.
# openssl rand -base64 32
LLM_FEEDBACK_HMAC_KEY=
# Days until llmFeedback docs expire (Firestore TTL on expiresAt). Default 90.
# LLM_FEEDBACK_RETENTION_DAYS=90

# Optional per-feature model overrides (defaults live in src/features/*.ts)
# GEMINI_MODEL_COMMON_USES=gemini-2.5-flash
# GEMINI_MODEL_CONTEXTUAL_GLOSS=gemini-2.5-flash-lite
# GEMINI_MODEL_SENSE_FIT=gemini-2.5-flash-lite
# GEMINI_MODEL_DIALOGUE_NUANCE=gemini-2.5-flash
# GEMINI_MODEL_SPAN_GLOSS=gemini-2.5-flash
# GEMINI_MODEL_SPAN_BREAKDOWN=gemini-2.5-flash
