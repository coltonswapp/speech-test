# Gemini settings for Studio. Copy the ones you need into .env.local.
# (Partial: auth, DB, R2 and webhook variables are documented in AUTH.md / Vercel.)

# Required for any Gemini call (text generation, tokenize, TTS).
GEMINI_API_KEY=

# Optional. Gemini text model for dialogue generation/revision and grammar
# generation. Defaults to gemini-3.5-flash-lite.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Optional. Gemini model for tokenize + readings (karaoke/aligner input).
# Defaults to gemini-3.8-flash (provisional, see lib/gemini/models.ts).
# Tokenize results are cached per line, so changing this only affects lines
# that have not been tokenized yet.
# GEMINI_TOKENIZE_MODEL=gemini-3.8-flash
